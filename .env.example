DJANGO_SECRET_KEY=TU_SECRET_KEY_REAL
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,carbonozero.mundacasolutions.com,app.carbonozero.mundacasolutions.com

CSRF_TRUSTED_ORIGINS=https://carbonozero.mundacasolutions.com,https://app.carbonozero.mundacasolutions.com
SECURE_SSL_REDIRECT=False

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://carbonozero.mundacasolutions.com,https://app.carbonozero.mundacasolutions.com

DOCUMENT_AI_PROVIDER=openrouter
# Produccion: usar un modelo visual especifico con structured outputs.
DOCUMENT_AI_MODEL=google/gemini-2.5-flash
OPENROUTER_API_KEY=
DOCUMENT_AI_FALLBACK_PROVIDER=
DOCUMENT_AI_FALLBACK_MODEL=

# Solo desarrollo/no estable: router aleatorio de modelos gratuitos.
# DOCUMENT_AI_MODEL=openrouter/free

# producción institucional:
# DOCUMENT_AI_PROVIDER=openai
# DOCUMENT_AI_MODEL=<modelo>
# OPENAI_API_KEY=

PUBLIC_FRONTEND_URL=https://carbonozero.mundacasolutions.com
FRONTEND_URL=https://app.carbonozero.mundacasolutions.com
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Carbono Zero <no-reply@carbonozero.mundacasolutions.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
PASSWORD_RESET_TIMEOUT=3600
VITE_APP_URL=https://app.carbonozero.mundacasolutions.com
VITE_API_URL=/api

LANDING_URL=https://carbonozero.mundacasolutions.com
APP_URL=https://app.carbonozero.mundacasolutions.com
LETSENCRYPT_EMAIL=

DATABASE_NAME=proyecto_huella
DATABASE_USER=proyecto_huella
DATABASE_PASSWORD=TU_PASSWORD_REAL
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_CONNECT_TIMEOUT=5

POSTGRES_DB=proyecto_huella
POSTGRES_USER=proyecto_huella
POSTGRES_PASSWORD=TU_PASSWORD_REAL
POSTGRES_HOST=db
POSTGRES_PORT=5432
# EC3-01 / Building Transparency Pilot — backend only, never VITE_*.
EC3_ENABLED=false
EC3_API_TOKEN=
# Enable only when the Pilot agreement authorizes cache and retained audit evidence.
EC3_STORAGE_ALLOWED=false
EC3_RIGHTS_REFERENCE=
EC3_RIGHTS_VALID_UNTIL=
EC3_CACHE_TTL_SECONDS=300
EC3_EVIDENCE_MAX_AGE_HOURS=168

# AI-INTELLIGENCE-01 — conversational assistant, backend only, never VITE_*.
# OPENROUTER_API_KEY is declared above (shared with DOCUMENT_AI_PROVIDER=openrouter).
OPENROUTER_ENABLED=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# No default model: must be set explicitly, e.g. anthropic/claude-3.5-sonnet.
OPENROUTER_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1200
AI_TEMPERATURE=0.2
AI_MAX_TOOL_ITERATIONS=4
AI_MAX_MESSAGES_PER_CONVERSATION=200
AI_MAX_REQUESTS_PER_ORG_PER_HOUR=60
